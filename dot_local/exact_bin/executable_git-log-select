#!/usr/bin/env bash
set -eu

if [ "${1:-}" = "--help" ]; then
  cat <<'EOF'
Usage: git log-select [<git-log-args>...]

Browse commits (default: HEAD) with fzf and git show --stat previews.
Enter copies the full hash and keeps the list open; Esc/Ctrl-C exits.
Requires MSYS2 on Windows or an OSC 52 terminal elsewhere.

Examples:
  git log-select
  git log-select --all
  git log-select main..HEAD -- src/

Use log arguments to filter commits; leave output formatting to this command.
EOF
  exit 0
fi

command -v fzf >/dev/null 2>&1 || {
  printf 'git log-select: fzf not found\n' >&2
  exit 1
}

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/git-log-select.XXXXXX")
trap 'rm -rf "$tmpdir"' EXIT
candidates="$tmpdir/candidates"

if git --no-pager log \
  --no-show-signature --color=never --no-graph -z \
  --format='%H%x09%h %s (%cr) <%an> %d' \
  "$@" > "$candidates"; then
  :
else
  status=$?
  exit "$status"
fi

if fzf \
  --read0 --no-multi --no-sort \
  --delimiter='\t' --with-nth=2.. \
  --header 'Enter: copy hash | Esc/Ctrl-C: exit' \
  --with-shell 'bash -c' \
  --preview 'git --no-pager show --no-relative --color=always --format=fuller --stat {1} --' \
  --preview-window=right:70% \
  --bind 'ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down' \
  --bind 'enter:transform-header(
    set -euo pipefail
    trap "printf \"Copy failed\n\"" ERR
    selected={1}
    if [ -z "$selected" ]; then
      printf "No commit selected\n"
      exit 0
    fi
    commit=$(git rev-parse --verify --end-of-options "$selected^{commit}")
    if [ "${OS:-}" = "Windows_NT" ]; then
      # ネイティブ fzf の子プロセスは MSYS2 の端末を引き継がないため。
      printf "%s" "$commit" > /dev/clipboard
    else
      encoded=$(printf "%s" "$commit" | base64 | tr -d "\r\n")
      printf "\033]52;c;%s\033\134" "$encoded" > /dev/tty
    fi
    printf "Copy request sent: %.12s\n" "$commit"
  )' \
  < "$candidates" > /dev/null; then
  :
else
  status=$?
  case "$status" in
    # 一致なし (1) とキャンセル (130) ではクリップボードを上書きしない。
    1|130) exit 0 ;;
    *) exit "$status" ;;
  esac
fi
