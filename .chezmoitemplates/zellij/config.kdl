// Nerd Fonts 依存の矢印セパレータ(Powerlineグリフ)を無効化する
simplified_ui true

// pane の周囲に枠線を表示する
pane_frame_style "full"

// マウスを使わないため、マウス操作を無効化する
mouse_mode false

stacked_pane_list_orientation "horizontal"

default_mode "locked"
keybinds preset="unlock-first" {
    pane {
        // floating pane を使わないため、関連するキーを解除する
        unbind "a" "e" "w"
        bind "n" { NewPane "stacked"; SwitchToMode "Locked"; }
    }
    shared_among "normal" "locked" {
        // Alt f は bash の単語移動にも使う
        unbind "Alt f"
    }
}
