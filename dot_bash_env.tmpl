# 外部コマンド(aqua等)の子プロセスがBASH_ENVを継承すると、本ファイルを再帰的に読み込むため、
# 本ファイルの実行中だけBASH_ENVの値を退避して解除する
_bash_env_path=$BASH_ENV
unset BASH_ENV

{{ if eq .chezmoi.os "windows" -}}
# zellij 経由の非ログインシェルでは、Windows 形式になった MANPATH が戻らないため。
case ";${MSYS2_ENV_CONV_EXCL-};" in
  *';MANPATH;'*|*';*;'*) ;;
  *) MSYS2_ENV_CONV_EXCL="${MSYS2_ENV_CONV_EXCL:+$MSYS2_ENV_CONV_EXCL;}MANPATH" ;;
esac
export MSYS2_ENV_CONV_EXCL
{{ end -}}

export EDITOR=nvim
export LANG=ja_JP.UTF-8
export GH_PAGER=delta
export GLAB_PAGER=delta
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
# 以下は`PATH="$HOME/.local/share/mise/shims:$PATH"`と同義
# Windowsのmiseはshimsしかサポートしていない
eval "$(mise activate bash --shims)"
# aqua があるときだけ PATH に追加
if command -v aqua >/dev/null 2>&1; then
  export PATH="$(aqua root-dir)/bin:$PATH"
fi

# ghq で管理している my-zk を探し、zk のノートブックディレクトリに設定する（未 clone なら空のまま）
if command -v ghq >/dev/null 2>&1; then
  _zk_repo=$(ghq list --exact --full-path my-zk | head -n1)
  [ -n "$_zk_repo" ] && export ZK_NOTEBOOK_DIR=$_zk_repo
  unset _zk_repo
fi

export BASH_ENV=$_bash_env_path
unset _bash_env_path
